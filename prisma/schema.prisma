generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String   @id @default(cuid())
  name        String
  age         Int
  avatar      String   @default("default")
  xp          Int      @default(0)
  level       Int      @default(1)
  streak      Int      @default(0)
  lastSaveAt  DateTime?
  totalSaved  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savingsGoals SavingsGoal[]
  transactions Transaction[]
  badges       UserBadge[]
  investments  Investment[]
  donations    Donation[]
}

model SavingsGoal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  targetAmount Float
  currentAmount Float  @default(0)
  frequency   String   // "daily" or "weekly"
  depositAmount Float
  emoji       String   @default("🎯")
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  goalId      String?
  type        String   // "deposit", "donation", "zakat", "investment"
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  user User         @relation(fields: [userId], references: [id])
  goal SavingsGoal? @relation(fields: [goalId], references: [id])
}

model Badge {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  xpReward    Int      @default(0)
  requirement String   // JSON string describing unlock condition

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Investment {
  id          String   @id @default(cuid())
  userId      String
  name        String
  amount      Float
  returnRate  Float    // annual return rate as decimal
  startDate   DateTime @default(now())
  isActive    Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])
}

model Donation {
  id          String   @id @default(cuid())
  userId      String
  type        String   // "charity" or "zakat"
  amount      Float
  recipient   String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
